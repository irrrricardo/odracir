    {
      "canonical_id": "su_fdf2c90f253694d0d205a64f",
      "canonical_key": {
        "canonical_id": "su_fdf2c90f253694d0d205a64f",
        "components": [
          {
            "name": "dataset",
            "values": [
              "norman et al. 2019 | as reprocessed by scfoundation"
            ]
          },
          {
            "name": "method",
            "values": [
              "baseline models | two simple baselines 1 no change model predicting control expression 2 additive model predicting sum of individual log-fold changes. neither uses double perturbation data.",
              "benchmark setup | models fine-tuned on all 100 single perturbations and 62 randomly chosen double perturbations tested on remaining 62 double perturbations. analysis repeated 5 times with different random partitions. prediction error measured as l2 distance for 1 000 most highly expressed genes. also evaluated using pearson delta and l2 for other gene subsets.",
              "deep learning models benchmarked | five foundation models scgpt scfoundation uce scbert geneformer and two other deep learning models gears cpa were fine-tuned or used as per original publications. for geneformer uce and scbert a linear decoder ridge regression was added to map cell embeddings to gene expression. fine-tuning limits gears and scfoundation limited to 3 days scfoundation trained for 5 epochs. uce used zero-shot with data leakage accepted. scgpt parameters from tutorial."
            ]
          },
          {
            "name": "name",
            "values": [
              "double perturbation prediction benchmark"
            ]
          },
          {
            "name": "protected_condition",
            "values": [
              "causal_rung:perturbation",
              "direction:increase",
              "direction:no_change",
              "negation:no",
              "study_arm:baseline",
              "time:3 days"
            ]
          },
          {
            "name": "result_metric",
            "values": [
              "l2 distance",
              "true positive rate vs false discovery proportion"
            ]
          },
          {
            "name": "task",
            "values": [
              "assess prediction of expression changes after double perturbations using data from norman et al. with 100 individual genes and 124 gene pairs upregulated in k562 cells."
            ]
          }
        ],
