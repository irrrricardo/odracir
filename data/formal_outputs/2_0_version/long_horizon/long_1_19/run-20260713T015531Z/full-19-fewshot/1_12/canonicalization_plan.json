    {
      "canonical_id": "su_deb6171dca295093a19070b5",
      "canonical_key": {
        "canonical_id": "su_deb6171dca295093a19070b5",
        "components": [
          {
            "name": "dataset",
            "values": [
              "adamson et al. 2016 | as provided by gears",
              "replogle et al. 2022 k562 | as provided by gears",
              "replogle et al. 2022 rpe1 | as provided by gears"
            ]
          },
          {
            "name": "method",
            "values": [
              "baseline linear model | simple linear model represents each read-out gene with k-dimensional vector g and each perturbation with l-dimensional vector p. g and p obtained from pca of training data or external sources. w solved via normal equations with ridge penalty λ=0.1. also included a mean baseline predicting average training expression.",
              "benchmark setup | test-training splitting from gears simulation procedure repeated twice. prediction error measured as l2 distance for 1 000 most highly expressed genes. analysis restricted to perturbations where all models had predictions 73 for adamson 398 for replogle k562 629 for replogle rpe1 .",
              "deep learning models for single perturbations | gears scgpt scfoundation uce scbert geneformer used as in double perturbation benchmark. cpa excluded as not designed for unseen perturbations. scfoundation excluded due to gene matching issues."
            ]
          },
          {
            "name": "name",
            "values": [
              "single perturbation prediction benchmark"
            ]
          },
          {
            "name": "protected_condition",
            "values": [
              "causal_rung:perturbation",
              "negation:not",
              "study_arm:baseline"
            ]
          },
          {
            "name": "result_metric",
            "values": [
              "l2 distance",
              "relative error to mean baseline"
            ]
          },
          {
            "name": "task",
            "values": [
              "benchmark prediction of effects of unseen single perturbations using two crispri datasets by replogle et al. k562 and rpe1 cells and one by adamson et al. k562 cells ."
            ]
          }
        ],
