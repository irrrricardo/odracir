    {
      "canonical_id": "su_2e0750a06ff46b8ef528d866",
      "canonical_key": {
        "canonical_id": "su_2e0750a06ff46b8ef528d866",
        "components": [
          {
            "name": "dataset",
            "values": [
              "l1000 bulk perturbation dataset | 1000 compounds across 82 cell lines",
              "perturb-seq dataset norman et al. | 108 497 cells 284 conditions 131 unique combination pairs",
              "sci-plex dataset | 290 889 cells from a549 k562 mcf7 cell lines treated with 188 compounds at 4 doses"
            ]
          },
          {
            "name": "method",
            "values": [
              "chemcpa | extension of cpa that replaces perturbation embedding dictionary with a pre-trained molecule encoder and perturbation encoder for chemical descriptors. allows prediction for unseen compounds.",
              "compositional perturbation autoencoder cpa | encoder-decoder architecture with adversarial disentanglement of perturbation and covariate embeddings. uses three loss functions gaussian negative log-likelihood for reconstruction adversarial loss for independence of embeddings and dose-response curves as small neural networks. hyperparameters embedding dimension 256 batch size 128 learning rate 1e-3 encoder/decoder hidden layers 4 with 512 neurons discriminator hidden layers 3 with 128 neurons. training includes random search over hyperparameters."
            ]
          },
          {
            "name": "name",
            "values": [
              "cpa model development and validation"
            ]
          },
          {
            "name": "protected_condition",
            "values": [
              "causal_rung:perturbation"
            ]
          },
          {
            "name": "result_metric",
            "values": [
              "improvement over scgen",
              "r2 score"
            ]
          },
          {
            "name": "task",
            "values": [
              "develop the compositional perturbation autoencoder cpa that combines linear interpretability with deep learning for single-cell response modeling.",
              "train cpa on six public datasets and a novel a549 dataset to predict responses to compounds doses time-series information and genetic perturbations."
            ]
          }
        ],
        "digest": "2e0750a06ff46b8ef528d866004385fe7de2a63c4d9c0f3c909a4ed6078ea402",
