    "research_questions": [
      {
        "question_id": "RQ_001",
        "statement": "How can large-scale single-cell perturbation data be used to build predictive models of cell behavior and understand context-dependent gene function?",
        "study_units": [
          {
            "claims": [
              {
                "additional_provenance": [],
                "claim_id": "clm_2df8766c605b739132de2541",
                "inference_basis_ids": [
                  "res_9cf5be5da7432b321069c7f8"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "8890ecf2f4865d1f26dd",
                  "page_end": 13,
                  "page_start": 13,
                  "paraphrased": false,
                  "text_excerpt": "treatment with RMC-6236, a pan-RAS inhibitor, produced the greatest effect in the KRAS-mutated group, with the most substantial difference in Vision scores observed at the lowest (p = 0.065, Welch’s t-test) and intermediate (p = 0.063, Welch’s t-test) doses compared to the unmutated RAS group"
                },
                "statement": "RMC-6236 shows a trend towards greater effect in KRAS-mutated cell lines compared to wild-type."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_4669158da1cc4caf4811b73a",
                "inference_basis_ids": [
                  "res_f2e9d3146a2221a3c9aef61d"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "fc718c9c87c6ed145338",
                  "page_end": 1,
                  "page_start": 1,
                  "paraphrased": true,
                  "text_excerpt": "Our high-throughput Mosaic platform, composed of a highly diverse and optimally balanced 'cell village', reduces batch effects and enables parallel profiling of thousands of conditions at single-cell resolution at an unprecedented scale."
                },
                "statement": "Mosaic platform reduces batch effects and enables parallel profiling at single-cell resolution."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_4d3f6564f0bb86f36a12baed",
                "inference_basis_ids": [
                  "res_24e399725f0c89ad9e9842db"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "8890ecf2f4865d1f26dd",
                  "page_end": 13,
                  "page_start": 13,
                  "paraphrased": false,
                  "text_excerpt": "Notably, treatment with Dabrafenib elicited the most pronounced effect in cell lines harboring BRAF mutations, as evidenced by significantly lower scores at both the lowest (P = 0.0013, Welch’s t-test) and highest (P = 0.00023, Welch’s t-test) doses, whereas KRAS-mutated lines showed minimal change"
                },
                "statement": "Dabrafenib shows stronger transcriptomic effect in BRAF-mutant cell lines than in KRAS-mutant or wild-type lines."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_a5560e515da9dfd30ad1ad46",
                "inference_basis_ids": [
                  "res_55ab6408f1500d28dd6d538c",
                  "res_5810291223a10b075d677d4e",
                  "res_6b78ee426cba2f0c855b3437",
                  "res_935dfdfcde2a38f6733adda1",
                  "res_b466b2b1d399454f07e08e95",
                  "res_e2d0d45005d21703ba1f7424"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "fc718c9c87c6ed145338",
                  "page_end": 1,
                  "page_start": 1,
                  "paraphrased": true,
                  "text_excerpt": "As the largest single-cell dataset to date, Tahoe-100M enables artificial-intelligence (AI)-driven models to learn context-dependent functions"
                },
                "statement": "Tahoe-100M is the largest single-cell perturbation dataset to date, enabling AI-driven models of context-dependent gene function."
              }
            ],
            "datasets": [
              {
                "dataset_id": "DS_001",
                "description": "Single-cell perturbation atlas of 100 million transcriptomic profiles measuring 1,100 small-molecule perturbations across 50 cancer cell lines. After filtering, 95.6 million cells pass full filters.",
                "name": "Tahoe-100M",
                "version_or_split": null
              }
            ],
            "evidence_spans": [
              {
                "content": "Tahoe-100M is released publicly to accelerate AI model development in systems biology.",
                "provenance": {
                  "chunk_id": "fc718c9c87c6ed145338",
                  "page_end": 1,
                  "page_start": 1,
                  "paraphrased": true,
                  "text_excerpt": "By publicly releasing this atlas, we aim to accelerate the creation and development of robust AI frameworks for systems biology"
                },
                "span_id": "ES_001"
              }
            ],
            "experiments_or_tasks": [
              "Culture of spheroids consisting of 50 cancer cell lines in suspension, drug treatment for 24 hours, dissociation, fixation, and scRNA-seq using Parse GigaLab kit.",
              "Sequencing of 1,786 sublibraries from 14 96-well plates to obtain ~1.4 trillion raw reads representing 153 million cells.",
              "SNP-based deconvolution to assign cells to cell line of origin."
            ],
            "methods": [
              {
                "method_id": "M_001",
                "name": "Mosaic platform",
                "protocol_description": "Spheroids of mixed cancer cell lines are cultured in suspension, treated with drugs or DMSO for 24 hours, dissociated, fixed, and profiled using the Parse GigaLab kit. Libraries prepared with combinatorial barcoding and sequencing adapters. Cell line identity deconvolved using detected SNPs."
              },
              {
                "method_id": "M_002",
                "name": "scRNA-seq data processing",
                "protocol_description": "Raw sequencing reads processed with Vevo's filtering criteria. Cells passed minimal filters (100.6 million) and full filters (95.6 million). Downstream analyses used the full-filtered set."
              }
            ],
            "name": "Generation of Tahoe-100M atlas using Mosaic platform",
