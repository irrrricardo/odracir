            "methods": [
              {
                "method_id": "m1",
                "name": "scDCA",
                "protocol_description": "Single-cell Drug-Conditional Adapter: efficient fine-tuning of a single-cell foundation model (scGPT) by training less than 1% of the original model parameters via a drug-conditional adapter module that incorporates molecular structure information while keeping the FM weights frozen."
              },
              {
                "method_id": "m2",
                "name": "scGPT fine-tuning (naive)",
                "protocol_description": "Standard fine-tuning of scGPT by training all or most parameters on the perturbation prediction task."
              },
              {
                "method_id": "m3",
                "name": "ChemCPA",
                "protocol_description": "Encoder-decoder architecture with separate embeddings for molecule and cell line, using an adversarial classifier for invariant basal states."
              },
              {
                "method_id": "m4",
                "name": "BioLORD",
                "protocol_description": "Deep generative framework for disentangled representations in single-cell data, partitioning latent space into subspaces for cell lines and perturbations."
              },
              {
                "method_id": "m5",
                "name": "SAMS-VAE",
                "protocol_description": "Sparse Additive Mechanism Shift Variational Autoencoder employing additive conditioning for perturbation prediction."
              }
            ],
