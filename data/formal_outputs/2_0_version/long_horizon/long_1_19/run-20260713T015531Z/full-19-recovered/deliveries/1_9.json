            "methods": [
              {
                "method_id": "m1",
                "name": "chemCPA",
                "protocol_description": "Chemical compositional perturbation autoencoder: an encoder-decoder architecture that encodes molecular structures of drugs (via a molecule encoder G) into latent perturbations, uses a non-linear dosage scaler S, and disentangles basal state from perturbation attributes via adversarial training (gradient reversal). Transfer learning is performed by pretraining on L1000 bulk RNA data and fine-tuning on sci-Plex3 single-cell data, handling differing gene sets via a projection layer or shared gene subset."
              },
