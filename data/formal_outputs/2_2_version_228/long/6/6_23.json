  "research_questions": [
    {
      "question_id": "RQ1",
      "statement": "How does over-squashing in GNNs arise from graph bottlenecks, and can curvature-based rewiring alleviate it?",
      "study_units": [
        {
          "claims": [
            {
              "additional_provenance": [],
              "claim_id": "clm_aa6093c98ad896706191269a",
              "inference_basis_ids": [
                "res_f112e70ba58dd29a6b0c89c9"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "c9b5a1edd47a1d941063",
                "page_end": 6,
                "page_start": 6,
                "paraphrased": false,
                "text_excerpt": "We also rigorously show that a random-walk based rewiring method might generally fail to obtain an edge set E′ with a significant improvement in its bottleneckedness as measured by the Cheeger constant."
              },
              "statement": "SDRF can reduce graph bottleneck more effectively than random-walk based rewiring."
            }
          ],
          "datasets": [],
          "evidence_spans": [],
          "experiments_or_tasks": [
            "Propose Stochastic Discrete Ricci Flow (SDRF) algorithm to alleviate negatively curved edges.",
            "Theoretically compare SDRF with random-walk based rewiring in terms of Cheeger constant improvement."
          ],
          "methods": [
            {
              "method_id": "M2",
              "name": "Stochastic Discrete Ricci Flow (SDRF)",
              "protocol_description": "Algorithm 1: iteratively adds an edge to support the most negatively curved edge and removes the most positively curved edge, using Balanced Forman curvature. Temperature τ controls stochasticity. Local modification ensures bounded graph edit distance."
            }
          ],
          "name": "Curvature-based rewiring method SDRF",
          "results": [
            {
