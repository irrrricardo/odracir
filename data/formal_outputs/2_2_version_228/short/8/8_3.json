  "research_questions": [
    {
      "question_id": "RQ1",
      "statement": "Can a neural operator parameterized directly in Fourier space provide an expressive and efficient architecture for learning mappings between function spaces for parametric PDEs?",
      "study_units": [
        {
          "claims": [
            {
              "additional_provenance": [],
              "claim_id": "clm_1b8c7f2c5f971107f5b2787c",
              "inference_basis_ids": [],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "64f5815fd8309cec61a3",
                "page_end": 8,
                "page_start": 8,
                "paraphrased": false,
                "text_excerpt": "We find the 3-d method to be more expressive and easier to train compared to its RNN-structured counterpart."
              },
              "statement": "FNO-3D is more expressive and easier to train than 2D+RNN counterparts."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_213c5e2fbe67d1680eb67db1",
              "inference_basis_ids": [
                "res_4f12ecd9a87abba8700b6314"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "ba392a4d66f4cb227728",
                "page_end": 1,
                "page_start": 1,
                "paraphrased": false,
                "text_excerpt": "it achieves superior accuracy compared to previous learning-based solvers under fixed resolution."
              },
              "statement": "FNO achieves superior accuracy compared to previous learning-based solvers under fixed resolution."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_286f87818d1da82d85a80a9b",
              "inference_basis_ids": [
                "res_cba3cfa0129522b867eed96a"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "64f5815fd8309cec61a3",
                "page_end": 8,
                "page_start": 8,
                "paraphrased": false,
                "text_excerpt": "As shown in Table 1, the FNO-3D has the best performance when there is sufficient data (ν = 1e−3, N = 1000 and ν = 1e−4, N = 10000). For the configurations where the amount of data is insufficient (ν = 1e−4, N = 1000 and ν = 1e−5, N = 1000), all methods have > 15% error with FNO-2D achieving the lowest."
              },
              "statement": "FNO-3D has best performance on Navier-Stokes with sufficient data; FNO-2D best with insufficient data."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_36f54eb2d8cdd82640ca43ec",
              "inference_basis_ids": [
                "res_d982e94571f69d7ddf9b57ad"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "ba392a4d66f4cb227728",
                "page_end": 1,
                "page_start": 1,
                "paraphrased": false,
                "text_excerpt": "It is up to three orders of magnitude faster compared to traditional PDE solvers."
              },
              "statement": "FNO is up to three orders of magnitude faster than traditional PDE solvers."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_72bc57876bff1e937bee2d03",
              "inference_basis_ids": [
                "res_f723e231e707d15350b4e047"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "64f5815fd8309cec61a3",
                "page_end": 8,
                "page_start": 8,
                "paraphrased": false,
                "text_excerpt": "The proposed Fourier neural operator obtains nearly one order of magnitude lower relative error compared to any benchmarks."
              },
              "statement": "FNO achieves nearly one order of magnitude lower relative error on Darcy Flow compared to benchmarks."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_74e934c088aae182036a554a",
              "inference_basis_ids": [
                "res_08073a9a3e34e1fbc0dc54e4"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "44d57a7bee933813c8f2",
                "page_end": 7,
                "page_start": 7,
                "paraphrased": false,
                "text_excerpt": "Compared to other neural operator methods such as GNO and MGNO that use Nyström sampling in physical space, the Fourier neural operator is both more accurate and more computationally efficient."
              },
              "statement": "FNO is more accurate and computationally efficient than GNO and MGNO on Burgers' equation."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_8e88894a7d207b3b0b5ac36b",
              "inference_basis_ids": [
                "res_f323a0c73a730844450e8676"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "ba392a4d66f4cb227728",
                "page_end": 1,
                "page_start": 1,
                "paraphrased": false,
                "text_excerpt": "The Fourier neural operator is the first ML-based method to successfully model turbulent flows with zero-shot super-resolution."
              },
              "statement": "FNO is the first ML method to model turbulent flows with zero-shot super-resolution."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_969a9ff4e7a2db5f13b3e28b",
              "inference_basis_ids": [
                "res_09fc03d44f815845039873af"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "44d57a7bee933813c8f2",
                "page_end": 7,
                "page_start": 7,
                "paraphrased": false,
                "text_excerpt": "Our proposed method obtains the lowest relative error compared to any of the benchmarks."
              },
              "statement": "FNO achieves the lowest relative error on Burgers' equation compared to benchmarks."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_c067f3e42dd429ac186569da",
              "inference_basis_ids": [
                "res_711236172a7d3b4b112a83a7"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "64f5815fd8309cec61a3",
                "page_end": 8,
                "page_start": 8,
                "paraphrased": false,
                "text_excerpt": "We again observe the invariance of the error with respect to the resolution."
              },
              "statement": "FNO error is invariant with resolution on Darcy Flow."
            },
            {
              "additional_provenance": [],
              "claim_id": "clm_dbdd26e300b3071f9a88c0f6",
              "inference_basis_ids": [
                "res_3027db87a59260d8e901f12c",
                "res_c9961c3884e8891fe1728391"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "44d57a7bee933813c8f2",
                "page_end": 7,
                "page_start": 7,
                "paraphrased": false,
                "text_excerpt": "Further, the error is invariant with the resolution, while the error of convolution neural network based methods (FCN) grows with the resolution."
              },
              "statement": "FNO error is invariant with resolution on Burgers' equation, unlike FCN."
            }
