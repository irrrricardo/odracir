          "methods": [
            {
              "method_id": "M1",
              "name": "Fourier Neural Operator (FNO)",
              "protocol_description": "Neural operator parameterizing the integral kernel directly in Fourier space. For time-dependent problems, FNO-2d uses 2D spatial convolution with RNN in time; FNO-3d uses 3D convolution in space-time."
            },
            {
              "method_id": "M2",
              "name": "FCN",
              "protocol_description": "Fully Convolution Network, a state-of-the-art neural network architecture for PDEs (Zhu & Zabaras, 2018)."
            },
            {
              "method_id": "M3",
              "name": "PCANN",
              "protocol_description": "Operator method using PCA as autoencoder on input/output data and interpolating latent spaces with a neural network (Bhattacharya et al., 2020)."
            },
            {
              "method_id": "M4",
              "name": "GNO",
              "protocol_description": "Original graph neural operator (Li et al., 2020b)."
            },
            {
              "method_id": "M5",
              "name": "MGNO",
              "protocol_description": "Multipole graph neural operator (Li et al., 2020a)."
            },
            {
              "method_id": "M6",
              "name": "LNO",
              "protocol_description": "Neural operator based on low-rank decomposition of the kernel, similar to unstacked DeepONet (Lu et al., 2019)."
            },
            {
              "method_id": "M7",
              "name": "ResNet",
              "protocol_description": "18 layers of 2-d convolution with residual connections (He et al., 2016)."
            },
            {
              "method_id": "M8",
              "name": "U-Net",
              "protocol_description": "Image-to-image regression with four blocks of 2-d convolutions and deconvolutions (Ronneberger et al., 2015)."
            },
            {
              "method_id": "M9",
              "name": "TF-Net",
              "protocol_description": "Network for learning turbulent flows based on spatial and temporal convolutions (Wang et al., 2020)."
            }
          ],
