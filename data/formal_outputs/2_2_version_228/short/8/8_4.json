          "methods": [
            {
              "method_id": "M1",
              "name": "Physics-Informed Neural Operator (PINO)",
              "protocol_description": "Combines operator learning and function optimization. Pre-training phase learns solution operator over multiple PDE instances using supervised data and physics constraints. Test-time optimization phase optimizes the pre-trained operator ansatz for a specific PDE instance using anchor loss and PDE loss."
            },
            {
              "method_id": "M2",
              "name": "Physics-Informed Neural Network (PINN)",
              "protocol_description": "Uses a neural network as ansatz for the solution function, optimized with soft physics constraints via auto-differentiation."
            },
            {
              "method_id": "M3",
              "name": "Fourier Neural Operator (FNO)",
              "protocol_description": "Learns solution operator via supervised learning on input-output pairs from an existing solver."
            },
            {
              "method_id": "M4",
              "name": "PINN-DeepONet",
              "protocol_description": "Physics-informed DeepONet for learning solution operator of parametric PDEs."
            }
