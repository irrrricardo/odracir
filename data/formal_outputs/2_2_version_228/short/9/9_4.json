          "experiments_or_tasks": [
            "Continued pretraining of Code Llama 7B and 34B on Proof-Pile-2.",
            "Few-shot evaluation on MATH, GSM8k, OCW, MMLU-STEM, SAT benchmarks.",
            "Formal theorem proving: Isabelle autoformalization and Lean tactic prediction.",
            "Majority voting evaluation on MATH, GSM8k, OCW, MMLU-STEM, SAT.",
            "Memorization analysis via n-gram overlap.",
            "Supervised finetuning on MetaMathQA.",
            "Tool use evaluation: MATH+Python and GSM8k+Python."
          ],
          "methods": [
            {
              "method_id": "M1",
              "name": "LLEMMA continued pretraining",
              "protocol_description": "Initialize from Code Llama. Continue training on Proof-Pile-2 with autoregressive language modeling objective. 7B model trained for 200B tokens, 34B for 50B tokens. bfloat16 mixed precision, GPT-NeoX, 256 A100 40GB GPUs, Tensor Parallelism (world size 2 for 7B, 8 for 34B), ZeRO Stage 1, Flash Attention 2. Global batch size 4M tokens, context length 4096. 7B: 42,000 steps, lr 1e-4, cosine decay to 1/30th. 34B: 12,000 steps, lr 5e-5, cosine decay to 1/30th. RoPE base period contracted to 10,000 for 7B, kept 1,000,000 for 34B."
            },
            {
              "method_id": "M2",
              "name": "Few-shot chain-of-thought evaluation",
              "protocol_description": "Greedy decoding, few-shot prompts. Metrics: accuracy."
            },
            {
              "method_id": "M3",
              "name": "Majority voting evaluation",
              "protocol_description": "Sampling with temperature T=0.6 for k=256,100; T=0.3 for k=16; nucleus sampling p=0.95. k=256 for MATH, k=100 for GSM8k and OCW, k=16 for MMLU-STEM and SAT."
            },
            {
              "method_id": "M4",
              "name": "Tool use evaluation",
              "protocol_description": "MATH+Python: model describes solution step in natural language then executes code; final answer is program. GSM8k+Python: write Python program to solve word problem. Few-shot prompts."
            },
            {
              "method_id": "M5",
              "name": "Isabelle autoformalization",
              "protocol_description": "Follow Jiang et al. (2023). Model can call sledgehammer. 30-second timeout. Baseline: Sledgehammer + heuristics at proof start. Pass@1 with greedy decoding."
            },
            {
              "method_id": "M6",
              "name": "Lean theorem proving",
              "protocol_description": "Best first search on miniF2F. N=1, S=32, T=100. Beam search for tactics, 10 min timeout. LeanDojo v1.1.2, Lean 4. Prompt with 3 (state, tactic) examples."
            },
            {
              "method_id": "M7",
              "name": "Supervised finetuning",
              "protocol_description": "Finetune LLEMMA-7B on MetaMathQA with identical hyperparameters to Yu et al. (2023)."
            }
          ],
