              "description": "Real-world data sets used for demonstration.",
              "name": "Real-world data",
              "version_or_split": null
            }
          ],
          "evidence_spans": [],
          "experiments_or_tasks": [
            "Discover causal ordering and connection strengths from observational data using ICA and permutation algorithms."
          ],
          "methods": [
            {
              "method_id": "M1",
              "name": "LiNGAM",
              "protocol_description": "Linear Non-Gaussian Acyclic Model: (1) Center data, (2) Apply ICA to estimate mixing matrix W, (3) Permute rows of W to minimize sum of squared off-diagonal elements in the lower triangular part, (4) Normalize to obtain B, (5) Prune edges using statistical tests."
            }
          ],
          "name": "LiNGAM discovery algorithm",
          "results": [
            {
              "additional_provenance": [],
              "metric_name": "Estimation accuracy",
