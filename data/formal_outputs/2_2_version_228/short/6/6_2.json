              "polarity": "positive",
              "provenance": {
                "chunk_id": "1b108bdf6a3481afe43b",
                "page_end": 1,
                "page_start": 1,
                "paraphrased": false,
                "text_excerpt": "we show how to discover the complete causal structure of continuous-valued data, under the assumptions that (a) the data generating process is linear, (b) there are no unobserved confounders, and (c) disturbance variables have non-Gaussian distributions of non-zero variances."
              },
              "statement": "The LiNGAM method can discover the complete causal structure under the stated assumptions."
            }
          ],
          "datasets": [
            {
              "dataset_id": "DS1",
              "description": "Artificially generated data with varying dimensions, sample sizes, network sparseness, and non-linearities.",
