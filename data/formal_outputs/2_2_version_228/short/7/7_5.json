  "research_questions": [
    {
      "question_id": "RQ1",
      "statement": "How does over-squashing in GNNs arise from graph bottlenecks, and can curvature-based rewiring alleviate it?",
      "study_units": [
        {
          "claims": [
            {
              "additional_provenance": [],
              "claim_id": "clm_b641b4dce8fb9d05e576d3cf",
              "inference_basis_ids": [
                "res_91c3c45bda3f5c28743efaf2"
              ],
              "polarity": "positive",
              "provenance": {
                "chunk_id": "c9b5a1edd47a1d941063",
                "page_end": 6,
                "page_start": 6,
                "paraphrased": false,
                "text_excerpt": "We also rigorously show that a random-walk based rewiring method might generally fail to obtain an edge set E′ with a significant improvement in its bottleneckedness as measured by the Cheeger constant."
              },
              "statement": "SDRF can reduce graph bottlenecks more effectively than random-walk based rewiring."
            }
          ],
          "datasets": [],
          "evidence_spans": [],
          "experiments_or_tasks": [
            "Propose Stochastic Discrete Ricci Flow (SDRF) algorithm to rewire graphs by adding edges around negatively curved edges and removing positively curved edges.",
            "Theoretically compare SDRF with random-walk based rewiring in terms of Cheeger constant improvement."
          ],
          "methods": [
            {
              "method_id": "M3",
              "name": "Stochastic Discrete Ricci Flow (SDRF)",
              "protocol_description": "Iteratively add an edge to support the most negatively curved edge (within 1-hop neighborhoods) and remove the most positively curved edge, using Balanced Forman curvature. Temperature τ controls stochasticity of edge addition."
            }
          ],
          "name": "Curvature-based rewiring method (SDRF)",
          "results": [
