              }
            ],
            "evidence_spans": [],
            "experiments_or_tasks": [
              "Apply Mosaic-seq to 71 constituent enhancers from 15 super-enhancers (page 5, 8).",
              "Combinatorial Mosaic-seq on TAD2 SE2 constituents (page 13).",
              "Develop Mosaic-seq to jointly measure a cell's transcriptome and its sgRNA modulators, quantifying effects of dCas9-KRAB-mediated enhancer repression in single cells (page 2).",
              "Test Mosaic-seq on ten sgRNAs targeting HS2, HBG1/2, HBE1, and negative controls in K562 cells (page 5).",
              "TNF-alpha stimulation experiment to create gold-standard datasets for differential expression analysis (page 5)."
            ],
            "methods": [
              {
                "method_id": "m1",
                "name": "Mosaic-seq",
                "protocol_description": "Infect wild-type cell line with lentiviral dCas9-KRAB-blast vector, then with barcoded sgRNA-puro lentiviral library, select with antibiotics, perform Drop-seq, and associate single-cell transcriptomes with sgRNA barcodes (page 2)."
              },
              {
                "method_id": "m2",
                "name": "Virtual FACS",
                "protocol_description": "Statistical framework using hypergeometric test to compare distribution of single-cell expression between perturbed and control cells (page 5)."
              },
              {
                "method_id": "m3",
                "name": "Penetrance and contribution modeling",
                "protocol_description": "Statistical model fitting to estimate single-cell penetrance (percentage of cells with altered expression) and expression contribution (level of repression in those cells) (page 10)."
              }
            ],
            "name": "Mosaic-seq method development and validation",
