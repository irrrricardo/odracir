    "research_questions": [
      {
        "question_id": "q1",
        "statement": "How to systematically measure endogenous enhancer activity at single-cell resolution and in combination?",
        "study_units": [
          {
            "claims": [
              {
                "additional_provenance": [],
                "claim_id": "clm_1c1704c985c91928183c0cc9",
                "inference_basis_ids": [
                  "res_4fb6f40aec3522955f267363",
                  "res_ff8f78761685b9a2df8eb284"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "299e10c1f93bea69018f",
                  "page_end": 5,
                  "page_start": 5,
                  "paraphrased": false,
                  "text_excerpt": "These results suggest that Mosaic-seq can robustly and specifically detect changes in gene expression induced by epigenome engineering of single cells in a manner that is consistent with traditional approaches."
                },
                "statement": "Mosaic-seq can robustly and specifically detect changes in gene expression induced by epigenome engineering in single cells, consistent with traditional approaches."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_6db716b07a9a4b646227c084",
                "inference_basis_ids": [
                  "res_1d5c629dccce08683c05425f",
                  "res_21ac5695e7a7afc3453d277e",
                  "res_6183596a89a23eb3cf717ec7"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "5dfae21409f71c3b735b",
                  "page_end": 8,
                  "page_start": 8,
                  "paraphrased": false,
                  "text_excerpt": "Overall, we find that these constituents have a widely variable effect on gene expression when averaged across cells, ranging from 18.0% to 88.9%, with a median of 42.3%. In contrast, most constituents tested elicit no detectable changes in expression, suggesting that they only contribute weakly to gene expression, at least when studied in isolation with KRAB."
                },
                "statement": "Only a small number of constituent enhancers are major effectors of target gene expression when repressed by KRAB."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_abb4088c06769c95f59b7f19",
                "inference_basis_ids": [
                  "res_226d122f25ce3b1d3675c60b",
                  "res_8d54926f0bffa68c5ee19415",
                  "res_960f80ffc20ae185afd35783",
                  "res_e981261f346c34077f06bec4"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "9106f4423cfaab8858a7",
                  "page_end": 13,
                  "page_start": 13,
                  "paraphrased": false,
                  "text_excerpt": "These observations suggest that simultaneous repression of multiple weak constituents can robustly alter super-enhancer activity and that it does so in a manner that is significantly greater than the repression of individual constituents."
                },
                "statement": "Simultaneous repression of multiple weak constituent enhancers can alter super-enhancer activity in a manner greatly exceeding repression of individual constituents."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_c1f01d231b2aab7776fbc512",
                "inference_basis_ids": [
                  "res_94bba8ae90407b057e289895",
                  "res_eb0015b5262185014ed3a70f"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "dbf00543b8893e5100e5",
                  "page_end": 10,
                  "page_start": 10,
                  "paraphrased": false,
                  "text_excerpt": "we observe a striking enrichment of the transcriptional co-activator p300 (3.3-fold enrichment; p = 2.0E-0004, Wilcoxon) and RNA polymerase II (RNAPII) (3.4-fold; p = 0.0047, Wilcoxon)."
                },
                "statement": "Binding of p300 and RNAPII are key features of active constituent enhancers."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_d2668f48dfa58fd66c68aab4",
                "inference_basis_ids": [
                  "res_a213f9a2972995ff8277aae0"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "299e10c1f93bea69018f",
                  "page_end": 5,
                  "page_start": 5,
                  "paraphrased": false,
                  "text_excerpt": "we estimate that the sgRNA barcode contamination rate is only 0.83% of barcode reads"
                },
                "statement": "Mosaic-seq can efficiently genotype sgRNAs in single cells with low barcode contamination rate."
              }
            ],
