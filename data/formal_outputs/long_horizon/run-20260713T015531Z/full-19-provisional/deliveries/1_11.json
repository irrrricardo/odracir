    "research_questions": [
      {
        "question_id": "q1",
        "statement": "How can we accurately predict transcriptional responses to multiplexed genetic perturbations and generalize to unseen conditions?",
        "study_units": [
          {
            "claims": [
              {
                "additional_provenance": [],
                "claim_id": "clm_192d69457c3197af021dbe1b",
                "inference_basis_ids": [],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "f8cd38ce362cc11f852c",
                  "page_end": 8,
                  "page_start": 8,
                  "paraphrased": true,
                  "text_excerpt": "The results presented in Table 5 reveal that while each encoder contributes to the model’s performance, neither encoder individually outperforms the effectiveness of the integrated model that combines both encoders. This underscores the synergistic effect of incorporating both the PertWeight and PertLocal encoders into AttentionPert."
                },
                "statement": "Combining PertWeight and PertLocal encoders yields synergistic improvement over using either alone."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_21a5a63243ecb7393d7ad94d",
                "inference_basis_ids": [],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "5b27833d5590c3ab7ae6",
                  "page_end": 7,
                  "page_start": 7,
                  "paraphrased": false,
                  "text_excerpt": "The ablation study presented in Table 4 demonstrates that AttentionPert achieves the lowest MSE(DE) in the seen 0/2 scenario, which indicates that the enhanced performance of AttentionPert is not solely attributable to any one of these three changes or their combination. Therefore, the design of AttentionPert is essential for its improved performance."
                },
                "statement": "AttentionPert's superior performance is not solely due to discarding cross-gene layer, reducing perturbed genes, or using Gene2Vec; the architecture design is essential."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_6970c65a1ff6b0f770d5449d",
                "inference_basis_ids": [],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "c91d3773bbbc4a4849a4",
                  "page_end": 1,
                  "page_start": 1,
                  "paraphrased": false,
                  "text_excerpt": "AttentionPert integrates global and local effects in a multi-scale model, representing both the nonuniform system-wide impact of the genetic perturbation and the localized disturbance in a network of gene–gene similarities, enhancing its ability to predict nuanced transcriptional responses to both single and multi-gene perturbations."
                },
                "statement": "AttentionPert integrates global and local perturbation effects via PertWeight and PertLocal encoders, improving prediction of nuanced transcriptional responses to single and multi-gene perturbations."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_787d82838157a6ef19440c86",
                "inference_basis_ids": [],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "5b27833d5590c3ab7ae6",
                  "page_end": 7,
                  "page_start": 7,
                  "paraphrased": false,
                  "text_excerpt": "Figure 6 illustrates the ability of AttentionPert to capture the nonadditive nature of multiplexed genetic perturbations. When predicting a seen 2/2 perturbation: FOXA1 and HOXB9, AttentionPert is adept at learning the combined response of these genes. This approach differs markedly from a simple additive model, which merely sums the transcriptional effects of each gene perturbed independently."
                },
                "statement": "AttentionPert captures nonadditive effects of multi-gene perturbations, outperforming the additive baseline."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_892259223d5f7d2d8936e302",
                "inference_basis_ids": [],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "5b27833d5590c3ab7ae6",
                  "page_end": 7,
                  "page_start": 7,
                  "paraphrased": false,
                  "text_excerpt": "Results demonstrate that AttentionPert with NA-bias more accurately predicts nonadditive expression changes."
                },
                "statement": "NA-bias module in PertLocal enhances prediction of nonadditive expression changes."
              },
              {
                "additional_provenance": [
                  {
                    "chunk_id": "ae0313d3caafbc4fcdf3",
                    "page_end": 5,
                    "page_start": 5,
                    "paraphrased": false,
                    "text_excerpt": "The results demonstrate that AttentionPert outperforms all baseline models across these scenarios, particularly in the most OOD scenario where both test genes are unseen in the train set."
                  }
                ],
                "claim_id": "clm_93eb0cbac5b3ccc40811f8d4",
                "inference_basis_ids": [
                  "res_0021fd8ea990033d6a02e226",
                  "res_40f0d3092fbd669784002156",
                  "res_58857efce328ade99aa79246",
                  "res_cd0a6f4f42bee385bb213257",
                  "res_d009149e7db2774d61d6b1fa"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "6b2a7aa6833f6775839d",
                  "page_end": 2,
                  "page_start": 2,
                  "paraphrased": false,
                  "text_excerpt": "AttentionPert outperforms prior methods including the SOTA GEARS model on RPE1 and K562 datasets (Replogle et al. 2022), each of which comprises >1000 single-gene perturbations, and on the Norman dataset containing 131 two-gene perturbations (Norman et al. 2019)."
                },
                "statement": "AttentionPert outperforms prior methods including SOTA GEARS on RPE1, K562, and Norman datasets."
              },
              {
                "additional_provenance": [],
                "claim_id": "clm_bc53e3e22bbf0591ffb27753",
                "inference_basis_ids": [
                  "res_58857efce328ade99aa79246"
                ],
                "polarity": "positive",
                "provenance": {
                  "chunk_id": "6b2a7aa6833f6775839d",
                  "page_end": 2,
                  "page_start": 2,
                  "paraphrased": false,
                  "text_excerpt": "Particularly, AttentionPert has exceptional capability in the most challenging out-of-distribution (OOD) task: predicting the effects of novel multi-gene perturbations where none of the perturbed genes have been encountered during the training phase."
                },
                "statement": "AttentionPert achieves superior performance in predicting out-of-distribution multi-gene perturbations where none of the perturbed genes are seen during training."
              }
            ],
