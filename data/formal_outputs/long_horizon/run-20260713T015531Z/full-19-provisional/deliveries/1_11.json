              {
                "dataset_id": "ds1",
                "description": "Dataset from Norman et al. 2019 containing 131 two-gene perturbations; preprocessed by GEARS.",
                "name": "Norman dataset",
                "version_or_split": "131 two-gene perturbations"
              },
              {
